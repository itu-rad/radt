# Copy to `.env` (docker compose reads it automatically) and edit.

# Which MLflow server the stack runs.
#
# Upstream MLflow -- plain tracking server, no radT extras. The radT client
# still logs runs, metrics and trace artifacts against it; you just view traces
# outside the MLflow UI.
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow
#
# radT fork (https://github.com/itu-rad/mlflow) -- upstream plus an "open trace"
# button on the run page, a radT dashboard tab, and the radt-trace endpoints
# that turn logged spans into Perfetto traces.
# MLFLOW_IMAGE=ghcr.io/itu-rad/mlflow:latest

# Fork only: where the fork's radT tab points. Must be reachable from the
# browser, not just from the MLflow container. The default goes through this
# stack's nginx; override when radT is served from another host.
# MLFLOW_RADT_URL=/radt/
